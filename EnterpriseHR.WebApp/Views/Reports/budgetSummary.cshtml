@model IEnumerable<EnterpriseHR.Domain.DTOs.DepartmentSummaryDTO>
@{
    ViewData["Title"] = "Department Budget Summary";
}

<h2>Department Budget Summary</h2>
<p class="text-muted">Rows highlighted in soft red indicate monthly active salaries exceeding the department budget[cite: 3, 4].</p>

<div class="table-responsive mt-3">
    <table class="table table-bordered align-middle">
        <thead class="table-light">
            <tr>
                <th>Code</th>
                <th>Department</th>
                <th class="text-end">Budget</th>
                <th class="text-center">Active Employees</th>
                <th class="text-end">Monthly Salary Total</th>
                <th class="text-end">Remaining Budget</th>
                <th class="text-center">Active Projects</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var isOverBudget = item.TotalMonthlySalary > item.Budget;
                <tr class="@(isOverBudget ? "table-danger" : "")">
                    <td>@item.DepartmentCode</td>
                    <td>@item.DepartmentName</td>
                    <td class="text-end">@item.Budget.ToString("N2")</td>
                    <td class="text-center">@item.ActiveEmployeeCount</td>
                    <td class="text-end">@item.TotalMonthlySalary.ToString("N2")</td>
                    <td class="text-end">@item.RemainingBudget.ToString("N2")</td>
                    <td class="text-center">@item.ActiveProjectCount</td>
                </tr>
            }
        </tbody>
    </table>
</div>