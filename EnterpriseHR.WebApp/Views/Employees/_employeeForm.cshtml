@model EnterpriseHR.WebApp.Models.EmployeeFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Employee.EmployeeNumber" class="form-label"></label>
        <input asp-for="Employee.EmployeeNumber" class="form-control" />
        <span asp-validation-for="Employee.EmployeeNumber" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Employee.FullName" class="form-label"></label>
        <input asp-for="Employee.FullName" class="form-control" />
        <span asp-validation-for="Employee.FullName" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Employee.Email" class="form-label"></label>
        <input asp-for="Employee.Email" type="email" class="form-control" />
        <span asp-validation-for="Employee.Email" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Employee.DepartmentId" class="form-label">Department</label>
        <select asp-for="Employee.DepartmentId" asp-items="Model.Departments" class="form-select">
            <option value="">-- Select Department --</option>
        </select>
        <span asp-validation-for="Employee.DepartmentId" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Employee.PositionId" class="form-label">Position</label>
        <select asp-for="Employee.PositionId" asp-items="Model.Positions" class="form-select">
            <option value="">-- Select Position --</option>
        </select>
        <span asp-validation-for="Employee.PositionId" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Employee.ManagerId" class="form-label">Direct Manager</label>
        <select asp-for="Employee.ManagerId" asp-items="Model.Managers" class="form-select">
            <option value="">-- No Manager (Top Level) --</option>
        </select>
    </div>
    <div class="col-md-4">
        <label asp-for="Employee.Salary" class="form-label"></label>
        <input asp-for="Employee.Salary" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="Employee.Salary" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Employee.JoinDate" class="form-label"></label>
        <input asp-for="Employee.JoinDate" type="date" class="form-control" />
        <span asp-validation-for="Employee.JoinDate" class="text-danger"></span>
    </div>
    <div class="col-md-4 d-flex align-items-end">
        <div class="form-check">
            <input asp-for="Employee.IsActive" class="form-check-input" />
            <label asp-for="Employee.IsActive" class="form-check-label">Active</label>
        </div>
    </div>
</div>